# =============================================================================
# Reguli custom Suricata — Sistem detecție amenințări Kubernetes
# =============================================================================

# Detectare port scan: 20+ conexiuni SYN de la același IP în 60 secunde
alert tcp any any -> $HOME_NET any (msg:"PORT SCAN DETECTED"; flags:S; threshold:type both, track by_src, count 20, seconds 60; sid:1000001; rev:1;)

# Detectare brute force SSH: 5+ încercări de la același IP în 60 secunde
alert tcp any any -> $HOME_NET 22 (msg:"SSH BRUTE FORCE ATTEMPT"; flow:to_server; threshold:type both, track by_src, count 5, seconds 60; sid:1000002; rev:1;)

# Detectare acces neobișnuit la API-ul Kubernetes (port 6443)
alert tcp any any -> $HOME_NET 6443 (msg:"K8S API UNUSUAL ACCESS"; flow:to_server; threshold:type both, track by_src, count 100, seconds 60; sid:1000003; rev:1;)

# Detectare posibil reverse shell: /bin/sh în trafic TCP stabilit
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"POTENTIAL REVERSE SHELL"; flow:established; content:"/bin/sh"; sid:1000006; rev:1;)
