# ============================================================================
# .env.example — k8s-threat-detection-system
# ============================================================================
# Copiază în .env (gitignored) și înlocuiește cu valorile clusterului tău.
#   cp .env.example .env
#
# Cum sunt folosite:
#   - dashboards/*/build.py    citește prin dashboards/_config.py
#   - attack-scenarios/*/attack.sh   citește prin attack-scenarios/_env.sh
# ============================================================================

# --- Kibana endpoint (folosit de Python builders pentru Saved Objects API) ---
KIBANA_URL=http://localhost:5601

# --- Elasticsearch endpoint (folosit de attack.sh pentru verificare detecții) ---
ES_URL=http://localhost:9200

# --- Kibana Data View IDs (UUID-uri generate la crearea data view-urilor) ---
# Le obții din Kibana → Stack Management → Data Views, apoi click pe view și
# vezi URL-ul: /app/management/kibana/dataViews/dataView/<UUID>
# Sau via API: curl <KIBANA_URL>/api/data_views | jq '.data_view[].id'
KIBANA_DATA_VIEW_ID=00000000-0000-0000-0000-000000000000
KIBANA_DATA_VIEW_ECS_ID=00000000-0000-0000-0000-000000000000

# ============================================================================
# Notă: alte fișiere cu config deployment-specific (NU .env, dar același pattern):
#   - falco/config/local-values.yaml   (gitignored, override pentru helm)
#     copiat din falco/config/local-values.yaml.example
#     conține Logstash webhook endpoint pentru falcosidekick
#   - infrastructure/ansible/inventories/hosts.ini   (gitignored)
#     copiat din hosts.ini.example, conține IP-urile reale ale nodurilor
# ============================================================================
